{
  "name": "nuri-crm",
  "version": "0.1.0",
  "private": true,
  "description": "NURI CRM — 매장 업무 관리 (Next.js)",
  "scripts": {
    "dev": "next dev -p 3001 -H 0.0.0.0",
    "dev:https": "next dev -p 3001 -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tunnel": "cloudflared tunnel --url http://localhost:3001",
    "test:scan": "node scripts/test-scan.mjs",
    "test:messages": "node scripts/test-messages.mjs",
    "verify:mutations": "node scripts/verify-mutation-affected.mjs",
    "verify:server-exports": "node scripts/verify-use-server-exports.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:rls": "node ../scripts/test-rls.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.0",
    "@hyunbinseo/holidays-kr": "^5.2027.2",
    "@phosphor-icons/react": "2.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tabler/icons-react": "^3.19.0",
    "@tanstack/react-table": "^9.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@yudiel/react-qr-scanner": "^2.0.4",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "motion": "^13.4.4",
    "next": "14.2.15",
    "nuqs": "^2.10.1",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^20.1.2",
    "react-hook-form": "^7.53.0",
    "react-to-print": "^2.15.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.2",
    "vaul": "^1.1.2",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@serwist/cli": "^9.5.12",
    "@serwist/next": "^9.5.12",
    "@types/node": "^24.19.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "serwist": "^9.5.12",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vitest": "^5.0.2",
    "zxing-wasm": "^3.0.3"
  }
}
