# NURI CRM 환경 변수 예시 — 실제 값은 .env.local 에 넣는다(git 제외).
#
# 로컬 검증:  npx supabase start  →  npx supabase status 의 API_URL / ANON_KEY
# 운영:       Supabase 대시보드 > Project Settings > API
#
# ⚠ service_role / secret 키는 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
#   브라우저 번들에 들어가 모든 RLS를 우회하게 된다.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
